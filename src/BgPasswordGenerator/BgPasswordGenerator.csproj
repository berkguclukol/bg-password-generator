<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>BgPasswordGenerator</RootNamespace>
    <AssemblyName>BgPasswordGenerator</AssemblyName>
    <Product>BG Password Generator</Product>
    <Version>4.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged and self-contained: runs without installing the Windows App Runtime -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Program.cs provides Main so Velopack's install/uninstall hooks run before the UI starts -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\icon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.4" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <!-- Keep in step with the vpk CLI version used by build.ps1 -->
    <PackageReference Include="Velopack" Version="1.2.158" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BgPasswordGenerator.Core\BgPasswordGenerator.Core.csproj" />
  </ItemGroup>

  <!--
    dotnet publish leaves out the app's own resources.pri and compiled XAML (.xbf) for unpackaged
    WinUI apps, and the published exe then crashes on startup. Copy them from the build output.
  -->
  <Target Name="PublishAppXamlResources" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_AppXamlResource Include="$(OutDir)$(AssemblyName).pri;$(OutDir)**\*.xbf" />
      <ResolvedFileToPublish Include="@(_AppXamlResource)" RelativePath="%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
