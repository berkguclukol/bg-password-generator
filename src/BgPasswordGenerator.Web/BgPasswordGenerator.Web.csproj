<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- No localized formatting here, so skip the large ICU download -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.7" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.7" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BgPasswordGenerator.Core\BgPasswordGenerator.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\BgPasswordGenerator\Assets\logo.svg" Link="wwwroot\logo.svg" />
  </ItemGroup>

</Project>
